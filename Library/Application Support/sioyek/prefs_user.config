# Base movement speed per scroll wheel tick (Default is ~1.0)
vertical_move_amount 1.5

# Scroll multiplier (Greatly increases responsiveness, default is 1.0)
touchpad_sensitivity 1.5

# Speed of the animation when smooth scrolling is enabled
smooth_scroll_speed 10.0

# BEGIN macOS system theme (managed by system-theme.py)
# Check macOS appearance once whenever Sioyek opens.
new_command _follow_system_theme /usr/bin/arch -arm64 /usr/bin/python3 /Users/faustozamparelli/.config/sioyek/system-theme.py --once
default_dark_mode 1
startup_commands _follow_system_theme
# END macOS system theme
