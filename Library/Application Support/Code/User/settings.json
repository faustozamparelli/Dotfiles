{
  "window.autoDetectColorScheme": true,
  "workbench.preferredDarkColorTheme": "Dark Modern",
  "workbench.preferredLightColorTheme": "Light Modern",
  "workbench.colorTheme": "Dark Modern",
  "workbench.colorCustomizations": {
    "[Dark Modern]": {
      "editor.background": "#000000",
      "sideBar.background": "#000000",
      "panel.background": "#000000",
      "editor.lineHighlightBackground": "#111827",
      "editorCursor.foreground": "#67e8f9"
    },
    "[Light Modern]": {
      "editor.background": "#ffffff",
      "sideBar.background": "#ffffff",
      "panel.background": "#ffffff",
      "editor.lineHighlightBackground": "#edf2f7",
      "editorCursor.foreground": "#0369a1"
    }
  },
  "window.zoomLevel": -0.5,
  "window.commandCenter": false,
  "workbench.layoutControl.enabled": false,
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  "editor.fontFamily": "SF Mono",
  "editor.fontSize": 15,
  "editor.fontLigatures": false,
  "editor.lineNumbers": "relative",
  "editor.cursorSurroundingLines": 6,
  "editor.renderWhitespace": "boundary",
  "editor.renderControlCharacters": true,
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "files.autoSave": "off",
  "explorer.autoReveal": true,
  "explorer.decorations.badges": true,
  "git.autorefresh": true,
  "git.decorations.enabled": true,
  "scm.diffDecorations": "all",
  "diffEditor.renderSideBySide": true,
  "terminal.integrated.defaultProfile.osx": "fish",
  "terminal.integrated.profiles.osx": {
    "fish": { "path": "/opt/homebrew/bin/fish", "args": ["--login"] }
  },
  "terminal.integrated.fontFamily": "SF Mono",
  "terminal.integrated.fontSize": 15,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.macOptionIsMeta": true,
  "terminal.integrated.scrollback": 10000,
  "ruff.configurationPreference": "filesystemFirst",
  "python.analysis.typeCheckingMode": "basic",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true
  },
  "vim.leader": "<space>",
  "vim.enableNeovim": false,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.incsearch": true,
  "vim.hlsearch": true,
  "vim.normalModeKeyBindingsNonRecursive": [
    // km:vscode.file.save
    { "before": ["<leader>", "<leader>"], "commands": ["workbench.action.files.save"] },
    // km:vscode.file.explorer
    { "before": ["<leader>", "e"], "commands": ["workbench.view.explorer"] },
    // km:vscode.find.files
    { "before": ["<leader>", "f", "f"], "commands": ["workbench.action.quickOpen"] },
    // km:vscode.find.grep
    { "before": ["<leader>", "f", "g"], "commands": ["workbench.action.findInFiles"] },
    // km:vscode.find.buffers
    { "before": ["<leader>", "f", "b"], "commands": ["workbench.action.showAllEditors"] },
    // km:vscode.find.recent
    { "before": ["<leader>", "f", "r"], "commands": ["workbench.action.openRecent"] },
    // km:vscode.git.status
    { "before": ["<leader>", "g", "s"], "commands": ["workbench.view.scm"] },
    // km:vscode.git.diff
    { "before": ["<leader>", "g", "d"], "commands": ["git.openChange"] },
    // km:vscode.git.next-hunk
    { "before": ["<leader>", "g", "n"], "commands": ["editor.action.dirtydiff.next"] },
    // km:vscode.git.previous-hunk
    { "before": ["<leader>", "g", "p"], "commands": ["editor.action.dirtydiff.previous"] },
    // km:vscode.language.rename
    { "before": ["<leader>", "l", "r"], "commands": ["editor.action.rename"] },
    // km:vscode.language.action
    { "before": ["<leader>", "l", "a"], "commands": ["editor.action.quickFix"] },
    // km:vscode.language.format
    { "before": ["<leader>", "l", "f"], "commands": ["editor.action.formatDocument"] },
    // km:vscode.language.diagnostics
    { "before": ["<leader>", "l", "d"], "commands": ["workbench.actions.view.problems"] },
    // km:vscode.buffer.next
    { "before": ["<leader>", "b", "l"], "commands": ["workbench.action.nextEditor"] },
    // km:vscode.buffer.previous
    { "before": ["<leader>", "b", "h"], "commands": ["workbench.action.previousEditor"] },
    // km:vscode.buffer.close
    { "before": ["<leader>", "b", "d"], "commands": ["workbench.action.closeActiveEditor"] },
    // km:vscode.help.keys
    { "before": ["<leader>", "?"], "commands": ["workbench.action.openGlobalKeybindings"] },
    // km:vscode.motion.line-start
    { "before": ["H"], "after": ["^"] },
    // km:vscode.motion.line-end
    { "before": ["L"], "after": ["$"] },
    // km:vscode.edit.redo
    { "before": ["U"], "after": ["<C-r>"] }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    // km:vscode.visual.move-down
    { "before": ["J"], "commands": ["editor.action.moveLinesDownAction"] },
    // km:vscode.visual.move-up
    { "before": ["K"], "commands": ["editor.action.moveLinesUpAction"] }
  ]
}
