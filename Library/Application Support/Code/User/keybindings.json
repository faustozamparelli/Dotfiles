[
  // km:vscode.tab.previous
  { "key": "cmd+h", "command": "workbench.action.previousEditor" },
  // km:vscode.tab.next
  { "key": "cmd+l", "command": "workbench.action.nextEditor" },
  // km:vscode.tab.move-left
  { "key": "cmd+shift+h", "command": "workbench.action.moveEditorLeftInGroup" },
  // km:vscode.tab.move-right
  { "key": "cmd+shift+l", "command": "workbench.action.moveEditorRightInGroup" },
  // km:vscode.pane.split-right
  { "key": "cmd+b", "command": "workbench.action.splitEditorRight" },
  // km:vscode.pane.split-down
  { "key": "cmd+n", "command": "workbench.action.splitEditorDown" },
  // km:vscode.tab.close
  { "key": "cmd+w", "command": "workbench.action.closeActiveEditor", "when": "!terminalFocus" },
  // km:vscode.terminal.new
  { "key": "cmd+t", "command": "workbench.action.terminal.new" },
  // km:vscode.terminal.side
  { "key": "cmd+shift+t", "command": "workbench.action.createTerminalEditorSide" },
  // km:vscode.escape
  { "key": "cmd+a", "command": "extension.vim_escape", "when": "editorTextFocus && vim.active && vim.mode != 'Normal'" },
  // km:vscode.pane.left
  { "key": "alt+h", "command": "workbench.action.navigateLeft", "when": "!terminalFocus" },
  // km:vscode.pane.down
  { "key": "alt+j", "command": "workbench.action.navigateDown", "when": "!terminalFocus" },
  // km:vscode.pane.up
  { "key": "alt+k", "command": "workbench.action.navigateUp", "when": "!terminalFocus" },
  // km:vscode.pane.right
  { "key": "alt+l", "command": "workbench.action.navigateRight", "when": "!terminalFocus" }
]
