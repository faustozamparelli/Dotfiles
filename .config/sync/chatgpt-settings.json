{
  "": {
    "approvals_reviewer": "auto_review",
    "model": "gpt-6-sol",
    "model_reasoning_effort": "medium"
  },
  "desktop": {
    "ambient-suggestions-enabled": true,
    "codeFontSize": 14,
    "conversationDetailMode": "STEPS_PROSE",
    "followUpQueueMode": "steer",
    "mac-menu-bar-enabled": false,
    "sansFontSize": 16
  },
  "desktop.open-in-target-preferences": {
    "global": "vscode"
  },
  "macos": {
    "DockIconPreference": "app-default",
    "SUAutomaticallyUpdate": true,
    "SUEnableAutomaticChecks": true
  },
  "plugins": {
    "browser@openai-bundled": true,
    "codex-app-tools@openai-bundled": true,
    "computer-use@openai-bundled": true,
    "documents@openai-primary-runtime": true,
    "github@openai-curated": true,
    "pdf@openai-primary-runtime": true,
    "presentations@openai-primary-runtime": true,
    "spreadsheets@openai-primary-runtime": true,
    "template-creator@openai-primary-runtime": true,
    "unified-computer-use@openai-bundled": true,
    "visualize@openai-bundled": true
  },
  "tui": {
    "status_line_use_colors": true,
    "theme": "ansi"
  }
}
