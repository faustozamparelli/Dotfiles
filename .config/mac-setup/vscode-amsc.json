{
  "workspaceFolder": "/shared-folder",
  "remoteUser": "ubuntu",
  "settings": {
    "clangd.path": "/home/ubuntu/.local/bin/vscode-amsc-clangd",
    "clangd.arguments": [
      "--background-index=false",
      "-j=2",
      "--query-driver=/u/sw/toolchains/gcc-glibc/11.2.0/prefix/bin/gcc,/u/sw/toolchains/gcc-glibc/11.2.0/prefix/bin/g++"
    ],
    "C_Cpp.intelliSenseEngine": "disabled",
    "terminal.integrated.defaultProfile.linux": "AMSC Bash",
    "terminal.integrated.profiles.linux": {
      "AMSC Bash": {
        "path": "/bin/bash",
        "args": [
          "--rcfile",
          "/u/sw/etc/bash.bashrc",
          "-i"
        ]
      }
    },
    "launch": {
      "version": "0.2.0",
      "configurations": [
        {
          "name": "AMSC: connect to Rosetta debug server",
          "type": "cppdbg",
          "request": "launch",
          "program": "${input:amscProgram}",
          "cwd": "${workspaceFolder}",
          "MIMode": "gdb",
          "miDebuggerPath": "/u/sw/toolchains/gcc-glibc/11.2.0/base/bin/gdb",
          "miDebuggerServerAddress": "127.0.0.1:54329",
          "stopAtEntry": true,
          "externalConsole": false
        }
      ],
      "inputs": [
        {
          "id": "amscProgram",
          "type": "promptString",
          "description": "Absolute Linux path of the executable started with ROSETTA_DEBUGSERVER_PORT=54329"
        }
      ]
    }
  },
  "extensions": [
    "llvm-vs-code-extensions.vscode-clangd",
    "ms-vscode.cpptools",
    "vscodevim.vim"
  ]
}
