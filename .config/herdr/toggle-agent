#!/usr/bin/env bash
set -euo pipefail

pane="${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}"
[[ -n "$pane" ]] || exit 0

current="$(herdr pane current --pane "$pane")"
workspace="$(jq -r '.result.pane.workspace_id' <<<"$current")"
cwd="$(jq -r '.result.pane.foreground_cwd // .result.pane.cwd' <<<"$current")"
current_agent="$(jq -r '.result.pane.agent // empty' <<<"$current")"

if [[ "$current_agent" == "codex" ]]; then
  agent_pane="$pane"
else
  agent_pane="$(
    herdr agent list \
      | jq -r --arg workspace "$workspace" \
        '.result.agents[]? | select(.workspace_id == $workspace and .agent == "codex") | .pane_id' \
      | head -n 1
  )"
fi

if [[ -n "$agent_pane" ]]; then
  layout="$(herdr pane layout --pane "$agent_pane")"
  pane_count="$(jq '.result.layout.panes | length' <<<"$layout")"
  if (( pane_count > 1 )); then
    herdr pane move "$agent_pane" --new-tab --workspace "$workspace" \
      --label Codex --focus >/dev/null
  else
    herdr agent focus "$agent_pane" >/dev/null
  fi
  exit 0
fi

created="$(
  herdr tab create --workspace "$workspace" --cwd "$cwd" --label Codex --focus
)"
agent_pane="$(jq -r '.result.root_pane.pane_id' <<<"$created")"
herdr pane run "$agent_pane" "exec codex" >/dev/null
