#!/usr/bin/env bash
set -euo pipefail

direction="${1:?direction required}"
nvim_key="${2:?Neovim key required}"
pane="${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}"

[[ -n "$pane" ]] || exit 0

if herdr pane process-info --pane "$pane" \
  | jq -e '.result.process_info.foreground_processes[]? | select(.name == "nvim")' \
    >/dev/null; then
  herdr pane send-keys "$pane" ctrl+w "$nvim_key" >/dev/null
else
  herdr pane focus --pane "$pane" --direction "$direction" >/dev/null
fi
