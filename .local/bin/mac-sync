#!/usr/bin/env bash
set -uo pipefail

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:$PATH"

setup="$HOME/.config/mac-setup"
shared="$setup/apps.tsv"
packages="$setup/packages.txt"
retired="$setup/retired-apps.tsv"
bare=(git --git-dir="$HOME/.config/git/dotfiles" --work-tree="$HOME")

pull=true
quiet=false
prune_packages=false

for arg in "$@"; do
  case "$arg" in
    --no-pull)
      pull=false
      ;;
    --quiet)
      quiet=true
      ;;
    --nuke)
      prune_packages=true
      ;;
    -h|--help)
      cat <<'EOF'
usage: mac-sync [--no-pull] [--quiet] [--nuke]

Options:
  --no-pull          Do not automatically pull the dotfiles repository.
  --quiet            Suppress normal informational output.
  --nuke             Make packages.txt authoritative for Homebrew formulae.
                     Extra top-level formulae are made eligible for autoremove,
                     then unused formulae and dependencies are removed.
EOF
      exit 0
      ;;
    *)
      echo "unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

log() {
  $quiet || printf '%s\n' "$*"
}

safe_host() {
  local name
  name="$(scutil --get ComputerName 2>/dev/null || hostname -s)"
  printf '%s' "$name" |
    LC_ALL=C tr '[:upper:]' '[:lower:]' |
    LC_ALL=C tr -cs '[:alnum:]' '-' |
    sed 's/-$//'
}

host="$(safe_host)"
local_apps="$setup/machines/$host.tsv"
skip_file="$setup/machines/$host.skip"

lock="${TMPDIR:-/tmp}/fausto-mac-sync.lock"

if ! mkdir "$lock" 2>/dev/null; then
  old_pid="$(cat "$lock/pid" 2>/dev/null || true)"

  if [[ "$old_pid" =~ ^[0-9]+$ ]] &&
     kill -0 "$old_pid" 2>/dev/null; then
    log "mac-sync is already running"
    exit 0
  fi

  # The process recorded in the lock is no longer alive.
  # Remove the entire stale lock directory, including temporary
  # files created by --nuke.
  rm -rf "$lock"

  mkdir "$lock" || {
    echo "Cannot recreate mac-sync lock: $lock" >&2
    exit 1
  }
fi

printf '%s\n' "$$" > "$lock/pid"

trap 'rm -rf "$lock"' EXIT

if [[ ! -f "$shared" || ! -f "$packages" ]]; then
  echo "mac-sync manifest is missing from $setup" >&2
  exit 1
fi


# ---------------------------------------------------------------------------
# Dotfiles
# ---------------------------------------------------------------------------

if $pull && [[ -d "$HOME/.config/git/dotfiles" ]]; then
  if "${bare[@]}" diff --quiet &&
     "${bare[@]}" diff --cached --quiet; then

    log "Pulling dotfiles..."

    "${bare[@]}" pull --ff-only || {
      echo "Warning: dotfiles pull failed; using the local manifest." >&2
    }
  else
    echo "Warning: local dotfile changes found; skipped automatic pull." >&2
  fi
fi

if [[ -f "$HOME/.config/sync/codex-technical.json" ]]; then
  python3 "$HOME/.config/sync/codex-technical.py" apply || {
    echo "Warning: Codex technical setup could not be applied; other Mac setup will continue." >&2
  }
fi


# ---------------------------------------------------------------------------
# Validate app manifests
# ---------------------------------------------------------------------------

manifest_files=("$shared")

[[ -f "$local_apps" ]] && manifest_files+=("$local_apps")
[[ -f "$retired" ]] && manifest_files+=("$retired")

if ! awk -F '\t' -v retired_manifest="$retired" '
  /^#/ || NF == 0 {
    next
  }

  NF != 3 ||
  ($1 != "cask" && $1 != "mas" && $1 != "direct" &&
   !($1 == "formula" && FILENAME == retired_manifest)) ||
  $2 == "" ||
  $3 == "" {
    bad=1
  }

  seen[$1 SUBSEP $2]++ {
    bad=1
  }

  END {
    exit bad
  }
' "${manifest_files[@]}"; then
  echo "Invalid or duplicate row in an app manifest." >&2
  exit 1
fi


# ---------------------------------------------------------------------------
# Homebrew
# ---------------------------------------------------------------------------

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew is required. Follow the bootstrap section in ~/README.md." >&2
  exit 1
fi

brew_prefix="$(brew --prefix)"

failed=0

# ---------------------------------------------------------------------------
# Machine-specific skips
# ---------------------------------------------------------------------------

is_skipped() {
  local key="$1"

  [[ -f "$skip_file" ]] &&
    grep -Fxq "$key" "$skip_file"
}


# ---------------------------------------------------------------------------
# Shared Homebrew formulae
# ---------------------------------------------------------------------------

wanted_packages=()

if ! awk '
  /^[[:space:]]*#/ || /^[[:space:]]*$/ {
    next
  }

  $0 ~ /^[[:space:]]/ || $0 ~ /[[:space:]]$/ || NF != 1 {
    bad=1
  }

  seen[$0]++ {
    bad=1
  }

  END {
    exit bad
  }
' "$packages"; then
  echo "packages.txt contains a duplicate or malformed formula name." >&2
  exit 1
fi

while IFS= read -r package; do
  [[ -z "$package" || "$package" == \#* ]] && continue
  wanted_packages+=("$package")
done < "$packages"

if ((${#wanted_packages[@]} == 0)); then
  echo "packages.txt contains no Homebrew formulae." >&2
  exit 1
fi


# ---------------------------------------------------------------------------
# Install / protect packages.txt
# ---------------------------------------------------------------------------

# Do this in ONE Homebrew invocation instead of checking every formula
# separately.
#
# Already-installed formulae are left at their current versions.
# Automatic cleanup is disabled here because mac-sync manages cleanup itself.

log "Checking shared Homebrew formulae..."

brew_log="$lock/brew-install.log"

if ! HOMEBREW_NO_INSTALL_UPGRADE=1 \
     HOMEBREW_NO_INSTALL_CLEANUP=1 \
     brew install "${wanted_packages[@]}" >"$brew_log" 2>&1; then

  cat "$brew_log" >&2
  failed=1
fi

# Everything in packages.txt is deliberate top-level user intent.
# brew tab accepts multiple formulae, so mark all of them with one invocation.

if ((failed == 0)); then
  brew tab \
    --installed-on-request \
    "${wanted_packages[@]}" \
    >/dev/null || {
      echo "Could not mark shared formulae as explicitly installed." >&2
      failed=1
    }
fi

# Homebrew isolates JupyterLab and Jupytext in separate Python environments.
# Restore their notebook extension after a JupyterLab upgrade.
if ((failed == 0)) &&
   [[ " ${wanted_packages[*]} " == *" jupyterlab "* ]] &&
   [[ " ${wanted_packages[*]} " == *" jupytext "* ]]; then
  lab_python="$(brew --prefix jupyterlab)/libexec/bin/python"
  if [[ -x "$lab_python" ]] &&
     ! "$lab_python" -c 'import jupytext, jupyterlab_jupytext' >/dev/null 2>&1; then
    log "Connecting Jupytext to JupyterLab..."
    jupytext_version="$(jupytext --version)"
    uv pip install --python "$lab_python" "jupytext==$jupytext_version" || {
      echo "Could not install Jupytext into JupyterLab's environment." >&2
      failed=1
    }
  fi
fi



# ---------------------------------------------------------------------------
# --nuke
# ---------------------------------------------------------------------------

if $prune_packages; then
  if ((failed)); then
    echo "Skipping Homebrew nuke because package setup failed." >&2
  else
    wanted_formulae="$lock/wanted-formulae"
    wanted_prefixes="$lock/wanted-prefixes"
    installed_formulae="$lock/installed-formulae"
    extra_formulae="$lock/extra-formulae"

    # Resolve ALL manifest aliases in one Homebrew invocation.
    #
    # For example:
    #
    #   python
    #
    # may resolve to:
    #
    #   /opt/homebrew/opt/python@3.14

    if ! brew --prefix \
         --installed \
         "${wanted_packages[@]}" \
         > "$wanted_prefixes"; then

      echo "Could not resolve packages.txt formulae; refusing to nuke." >&2
      failed=1
    fi

    if ((failed == 0)); then

      while IFS= read -r prefix; do
        [[ -z "$prefix" ]] && continue
        basename "$prefix"
      done < "$wanted_prefixes" |
        LC_ALL=C sort -u \
        > "$wanted_formulae"


      # Get all explicitly requested formulae with ONE Homebrew invocation.

      brew list \
        --formula \
        --installed-on-request |
        LC_ALL=C sort -u \
        > "$installed_formulae"


      # installed-on-request MINUS packages.txt = temporary packages

      LC_ALL=C comm \
        -23 \
        "$installed_formulae" \
        "$wanted_formulae" \
        > "$extra_formulae"


      if [[ -s "$extra_formulae" ]]; then
        log "Temporary Homebrew formulae not present in packages.txt:"

        extra_packages=()

        while IFS= read -r formula; do
          [[ -z "$formula" ]] && continue

          log "  $formula"
          extra_packages+=("$formula")
        done < "$extra_formulae"


        # Mark ALL temporary packages dependency-only in ONE invocation.

        log "Removing temporary Homebrew formulae..."

        if brew tab \
             --no-installed-on-request \
             "${extra_packages[@]}" \
             >/dev/null; then

          # Homebrew decides which packages are actually safe to remove.
          if ! brew autoremove; then
            echo "Homebrew autoremove failed; protecting any temporary formulae that remain installed." >&2

            remaining_packages=()
            for formula in "${extra_packages[@]}"; do
              if brew list --versions "$formula" >/dev/null 2>&1; then
                remaining_packages+=("$formula")
              fi
            done

            if ((${#remaining_packages[@]})); then
              brew tab --installed-on-request "${remaining_packages[@]}" >/dev/null || true
            fi
            failed=1
          fi

        else
          echo "Could not mark temporary formulae for removal." >&2
          failed=1
        fi

      else
        log "No temporary Homebrew formulae to remove."
      fi
    fi
  fi
fi


# ---------------------------------------------------------------------------
# pnpm
# ---------------------------------------------------------------------------

# pnpm keeps global executable shims here. Creating the directory during sync
# ensures Fish can add it to PATH immediately on every managed Mac.

if brew list --versions pnpm >/dev/null 2>&1; then
  mkdir -p "$HOME/Library/pnpm/bin"
fi

# Keep the Homebrew Python command stable for scripts and editor integrations.
python_bin="$brew_prefix/bin/python3"
toolchain_bin="$HOME/.local/toolchains/bin"
mkdir -p "$toolchain_bin"
if [[ -e "$toolchain_bin/python" && ! -L "$toolchain_bin/python" ]]; then
  echo "Cannot manage $toolchain_bin/python because it is not a symlink." >&2
  failed=1
elif [[ -x "$python_bin" ]]; then
  ln -sfn "$python_bin" "$toolchain_bin/python"
fi

# Supply the container's installed library headers to Neovim without
# installing course libraries on macOS. A regular file is needed because the
# container cannot follow a symlink to the host's dotfiles checkout.
if [[ -d "$HOME/shared-folder" ]] &&
   command -v docker >/dev/null 2>&1 &&
   [[ "$(docker inspect --format '{{.State.Running}}' amsc 2>/dev/null || true)" == true ]]; then
  amsc_config="$HOME/shared-folder/.clangd"
  amsc_generated="$lock/amsc.clangd"
  if ! "$setup/amsc-clangd-config.sh" > "$amsc_generated"; then
    rm -f "$amsc_generated"
    echo "Warning: could not discover AMSC headers; keeping the existing .clangd." >&2
  elif [[ -L "$amsc_config" && "$(readlink "$amsc_config")" == "$setup/amsc.clangd" ]]; then
    rm "$amsc_config"
  fi
  if [[ -s "$amsc_generated" && -f "$amsc_config" ]] &&
     { head -n 1 "$amsc_config" | grep -Fqx '# Managed by mac-sync for container-backed editing in ~/shared-folder.' ||
       head -n 1 "$amsc_config" | grep -Fqx '# This file is linked into ~/shared-folder for container-backed editing.'; } &&
     ! cmp -s "$amsc_generated" "$amsc_config"; then
    cp "$amsc_generated" "$amsc_config"
  elif [[ -s "$amsc_generated" && ! -e "$amsc_config" && ! -L "$amsc_config" ]]; then
    cp "$amsc_generated" "$amsc_config"
  fi
fi



# ---------------------------------------------------------------------------
# Retired applications
# ---------------------------------------------------------------------------

installed_casks="$(brew list --cask 2>/dev/null || true)"

retire_manifest() {
  local source
  local identifier
  local name
  local token
  local app_path
  local trash_bin
  local tool
  local link
  local -a retired_formulae=()

  [[ -f "$retired" ]] || return 0

  trash_bin="$brew_prefix/opt/trash/bin/trash"
  [[ -x "$trash_bin" ]] || trash_bin="/usr/bin/trash"

  while IFS=$'\t' read -r -u 3 source identifier name; do
    [[ -z "$source" || "$source" == \#* ]] && continue

    # Dedicated PDF retirement handles permanent deletion and reports privacy
    # failures. Do not hide failures by moving remaining apps to Trash.
    case "$source:$identifier" in
      cask:mupdf|cask:sioyek|direct:sioyek|formula:mupdf|mas:1498912833|mas:1378123825)
        continue ;;
    esac

    if [[ "$source" == "formula" ]]; then
      if brew list --formula --versions "$identifier" >/dev/null 2>&1; then
        retired_formulae+=("$identifier")
      fi
      continue
    fi

    token="${identifier##*/}"
    app_path="/Applications/$name.app"

    if [[ "$source" == "cask" ]] &&
       grep -Fxq "$token" <<<"$installed_casks"; then

      log "Removing retired app $name from Homebrew..."

      if [[ "$token" == "chatgpt" || "$token" == "visual-studio-code" ]]; then
        # Zap can fail on macOS privacy-protected files. Force removal clears
        # the cask record, then the named per-user data is cleaned below.
        if ! brew uninstall --cask --zap "$token"; then
          brew uninstall --cask --force "$token" || failed=1
        fi
      else
        brew uninstall --cask "$token" || failed=1
      fi
    fi

    if [[ -d "$app_path" ]]; then
      log "Moving retired app $name to Trash..."

      if [[ -x "$trash_bin" ]]; then
        "$trash_bin" "$app_path" || failed=1
      else
        echo "Cannot retire $name: no trash command is available." >&2
        failed=1
      fi
    fi

    # The cask may already be gone while user caches remain.
    case "$token" in
      visual-studio-code)
        rm -rf -- "$HOME/.vscode" \
          "$HOME/Library/Application Support/Code" \
          "$HOME/Library/Caches/com.microsoft.VSCode" \
          "$HOME/Library/Caches/com.microsoft.VSCode.ShipIt" \
          "$HOME/Library/HTTPStorages/com.microsoft.VSCode" \
          "$HOME/Library/Preferences/com.microsoft.VSCode.plist" \
          "$HOME/Library/Preferences/com.microsoft.VSCode.helper.plist" \
          "$HOME/Library/Saved Application State/com.microsoft.VSCode.savedState" || failed=1
        ;;
      chatgpt)
        # Codex is a separate, still-managed app. Its com.openai.codex and
        # CUAService data must survive retirement of the ChatGPT desktop app.
        rm -rf -- "$HOME/Library/Application Support/com.openai.chat" \
          "$HOME/Library/Caches/com.openai.chat" \
          "$HOME/Library/Caches/Homebrew/Cask"/chatgpt--* \
          "$HOME/Library/Caches/Homebrew/downloads"/*--ChatGPT-darwin-arm64-* \
          "$HOME/Library/HTTPStorages/com.openai.chat" \
          "$HOME/Library/HTTPStorages/com.openai.chat.binarycookies" \
          "$HOME/Library/Preferences/com.openai.chat.plist" \
          "$HOME/Library/Saved Application State/com.openai.chat.savedState" || failed=1
        ;;
    esac
  done 3< "$retired"

  if ((${#retired_formulae[@]})); then
    log "Removing retired formulae no longer required by shared packages..."
    if brew tab --no-installed-on-request "${retired_formulae[@]}"; then
      brew autoremove || failed=1
    else
      failed=1
    fi
  fi

  # Clean up the links and user-site file previously created by mac-sync.
  if grep -Fq $'formula\tgcc\t' "$retired"; then
    for tool in gcc g++; do
      link="$HOME/.local/toolchains/bin/$tool"
      [[ -L "$link" ]] && rm -f "$link"
    done
    rmdir "$HOME/.local/toolchains/bin" 2>/dev/null || true
  fi
  if grep -Fq $'formula\tpytorch\t' "$retired" && [[ -d "$HOME/Library/Python" ]]; then
    find "$HOME/Library/Python" -type f -name homebrew-shared.pth -delete
  fi
  if grep -Fq $'formula\tfaustozamparelli/local/lis\t' "$retired"; then
    # Homebrew's autoremove does not select formulae from a local, gitless tap.
    if brew list --formula --versions lis >/dev/null 2>&1; then
      brew uninstall --formula lis || failed=1
    fi
    if ! brew list --formula --versions lis >/dev/null 2>&1 &&
       [[ -f "$(brew --repository)/Library/Taps/faustozamparelli/homebrew-local/Formula/lis.rb" ]]; then
      brew untap faustozamparelli/local || failed=1
    fi
  fi
  if grep -Fq $'formula\topen-mpi\t' "$retired" &&
     ! brew list --formula --versions pmix >/dev/null 2>&1 &&
     [[ -f "$brew_prefix/etc/pmix-mca-params.conf" ]]; then
    "$trash_bin" "$brew_prefix/etc/pmix-mca-params.conf" || failed=1
  fi
}

# Permanent, idempotent PDF retirement. A subshell keeps cleanup helpers and
# its status isolated; no separate installer/cleanup script is needed.
retire_pdf_viewers() (
  failed=0
  remove_pdf_data() {
    local path
    for path in "$@"; do
      [[ -e "$path" || -L "$path" ]] || continue
      log "Removing retired PDF viewer data: $path"
      rm -rf -- "$path" || failed=1
    done
  }
  for app in Highlights Negative Sioyek MuPDF mupdf; do
    if pgrep -if "/${app}.app/Contents/MacOS/" >/dev/null; then
      osascript -e "tell application \"$app\" to quit" || failed=1
      sleep 1
      if pgrep -if "/${app}.app/Contents/MacOS/" >/dev/null; then
        echo "Cannot retire $app while running (check save dialogs)." >&2
        exit 1
      fi
    fi
  done
  for agent in "$HOME"/Library/LaunchAgents/*[Ss]ioyek*.plist; do
    [[ -f "$agent" ]] || continue
    launchctl bootout "gui/$(id -u)" "$agent" 2>/dev/null || true
    remove_pdf_data "$agent"
  done
  for token in sioyek mupdf; do
    if brew list --cask "$token" >/dev/null 2>&1; then
      brew uninstall --cask --zap "$token" || {
        brew uninstall --cask --force "$token" || failed=1
      }
    fi
  done
  if brew list --formula --versions mupdf >/dev/null 2>&1; then
    brew uninstall --formula mupdf || failed=1
  fi
  for app in Highlights Negative Sioyek sioyek MuPDF mupdf; do
    path="/Applications/$app.app"
    if [[ -d "$path" && ! -w "$path/Contents" ]]; then
      # Scheduled sync never prompts; authorize in a terminal with sudo -v.
      sudo -n /bin/rm -rf -- "$path" || failed=1
    else
      remove_pdf_data "$path"
    fi
    remove_pdf_data "$HOME/Applications/$app.app"
  done
  remove_pdf_data "$HOME/.config/sioyek" "$HOME/.config/mupdf" "$HOME/.mupdf" \
    "$HOME/.cache/sioyek" "$HOME/.cache/mupdf" \
    "$HOME/.local/share/sioyek" "$HOME/.local/share/mupdf" \
    "$HOME/Library/Application Support/Sioyek" "$HOME/Library/Application Support/sioyek" \
    "$HOME/Library/Application Support/MuPDF" "$HOME/Library/Application Support/mupdf" \
    "$HOME/Library/Logs/sioyek-system-theme.log"
  cache_root="$(getconf DARWIN_USER_CACHE_DIR)"
  temp_root="$(getconf DARWIN_USER_TEMP_DIR)"
  for id in net.highlightsapp.universal pl.mackozer.Negative info.sioyek.sioyek com.artifex.mupdf; do
    for root in "Application Support" "Caches" "HTTPStorages" "WebKit" "Containers" "Application Scripts"; do
      remove_pdf_data "$HOME/Library/$root/$id"
    done
    remove_pdf_data "$HOME/Library/Preferences/$id.plist" \
      "$HOME/Library/Saved Application State/$id.savedState" \
      "$HOME/Library/HTTPStorages/$id.binarycookies" "$cache_root/$id" "$temp_root/$id"
    for path in "$HOME/Library/Preferences/ByHost/$id".*.plist \
      "$cache_root"/com.apple.WebKit.*+"$id"; do
      remove_pdf_data "$path"
    done
  done
  for path in "$HOME"/Library/Logs/DiagnosticReports/[Ss]ioyek-* \
    "$HOME"/Library/Logs/DiagnosticReports/Highlights-* \
    "$HOME"/Library/Logs/DiagnosticReports/Negative-* \
    "$HOME"/Library/Logs/DiagnosticReports/[Mm]u[Pp][Dd][Ff]-* \
    "$HOME"/Library/Application\ Support/CrashReporter/[Ss]ioyek_*.plist \
    "$HOME"/Library/Caches/Homebrew/*mupdf* \
    "$HOME"/Library/Caches/Homebrew/*sioyek* \
    "$HOME"/Library/Caches/Homebrew/downloads/*--mupdf* \
    "$HOME"/Library/Caches/Homebrew/downloads/*--sioyek* \
    /Applications/.sioyek-codex-new /Applications/.sioyek-codex-old; do
    remove_pdf_data "$path"
  done
  # Never remove cloud documents. Only prune empty app directories.
  cloud="$HOME/Library/Mobile Documents/iCloud~net~highlightsapp"
  rmdir "$cloud/Documents" 2>/dev/null || true
  if [[ -d "$cloud" ]]; then
    rmdir "$cloud" 2>/dev/null || sudo -n /bin/rmdir "$cloud" 2>/dev/null || true
  fi
  exit "$failed"
)
if grep -Fq $'direct\tsioyek\t' "$retired"; then
  retire_pdf_viewers || failed=1
  installed_casks="$(brew list --cask 2>/dev/null || true)"
fi
retire_manifest


# ---------------------------------------------------------------------------
# Install applications
# ---------------------------------------------------------------------------

install_manifest() {
  local manifest="$1"
  local source
  local identifier
  local name
  local token
  local script

  [[ -f "$manifest" ]] || return 0

  while IFS=$'\t' read -r -u 3 source identifier name; do
    [[ -z "$source" || "$source" == \#* ]] && continue

    if [[ "$manifest" == "$shared" ]] &&
       is_skipped "$source:$identifier"; then

      log "Skipping $name on $host"
      continue
    fi

    case "$source" in

      cask)
        token="${identifier##*/}"

        if ! grep -Fxq "$token" <<<"$installed_casks"; then

          if [[ "$token" == "protonvpn" &&
                -d "/Applications/ProtonVPN.app" ]]; then

            log "ProtonVPN is already installed outside Homebrew; leaving it in place."
            continue
          fi

          log "Installing $name from Homebrew..."

          brew install --cask --adopt "$identifier" || failed=1
        fi
        ;;

      mas)
        if [[ ! -d "/Applications/$name.app" ]]; then

          if command -v mas >/dev/null 2>&1; then
            log "Installing $name from the App Store..."
            mas install "$identifier" || failed=1
          else
            echo "Cannot install $name: mas is unavailable." >&2
            failed=1
          fi
        fi
        ;;

      direct)
        script="$setup/direct/$identifier.sh"

        if [[ -x "$script" ]]; then
          log "Checking pinned direct install: $name"
          "$script" || failed=1
        else
          echo "Missing executable direct installer: $script" >&2
          failed=1
        fi
        ;;

      *)
        echo "Unknown app source '$source' in $manifest" >&2
        failed=1
        ;;
    esac

  done 3< "$manifest"
}

install_manifest "$shared"
install_manifest "$local_apps"

# Merge only portable Pi defaults. Credentials, sessions, and local extensions
# stay in ~/.pi/agent and are never read into the dotfiles repository.
if command -v pi >/dev/null 2>&1 &&
   [[ -f "$HOME/.config/sync/pi-agent.json" ]]; then
  python3 - "$HOME/.config/sync/pi-agent.json" "$HOME/.pi/agent/settings.json" <<'PYPI' || {
import json
import os
import sys
from pathlib import Path

profile = json.loads(Path(sys.argv[1]).read_text())
target = Path(sys.argv[2])
current = json.loads(target.read_text()) if target.exists() else {}
updated = {**current, **profile}
if updated != current:
    target.parent.mkdir(parents=True, exist_ok=True)
    temporary = target.with_name(target.name + '.new')
    temporary.write_text(json.dumps(updated, indent=2) + '\n')
    os.chmod(temporary, 0o600)
    temporary.replace(target)
PYPI
    echo "Warning: Pi defaults could not be applied; other Mac setup will continue." >&2
  }
fi

# Retire old file associations after removing VS Code.
python3 "$setup/remove-open-in-herdr.py" || failed=1


# ---------------------------------------------------------------------------
# Keyboard shortcuts
# ---------------------------------------------------------------------------

shortcuts_changed=false

for shortcut_file in "$setup/keyboard/"*.plist; do
  [[ -f "$shortcut_file" ]] || continue

  domain="$(basename "$shortcut_file" .plist)"
  current="$(defaults read "$domain" NSUserKeyEquivalents 2>/dev/null || true)"
  wanted="$(cat "$shortcut_file")"

  if [[ "$current" != "$wanted" ]]; then
    if defaults write "$domain" NSUserKeyEquivalents "$wanted" 2>/dev/null; then
      shortcuts_changed=true
    else
      log "macOS did not allow background shortcut changes for $domain; leaving them unchanged."
    fi
  fi
done

$shortcuts_changed &&
  killall cfprefsd 2>/dev/null || true


# ---------------------------------------------------------------------------
# Keymap documentation
# ---------------------------------------------------------------------------

if [[ -x "$HOME/.config/keymaps/keymap-docs" ]]; then
  "$HOME/.config/keymaps/keymap-docs" --check || failed=1
fi


# ---------------------------------------------------------------------------
# Finish
# ---------------------------------------------------------------------------

if ((failed)); then
  echo "mac-sync finished with errors; rerun it after resolving the messages above." >&2
  exit 1
fi

log "mac-sync complete for $host"
