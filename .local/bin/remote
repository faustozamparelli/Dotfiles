#!/usr/bin/python3
"""Timed awake/AC-only remote sessions sharing one sleep recovery record."""
import argparse
import contextlib
import fcntl
import json
import os
from pathlib import Path
import plistlib
import pwd
import re
import socket
import subprocess
import sys
import tempfile
import time

LABEL = "com.fausto.remote-mode"
DIRECTORY = Path("/var/db") / LABEL
STATE = DIRECTORY / "state.json"
RESULT = DIRECTORY / "last-result.json"
HELPER = Path("/Library/PrivilegedHelperTools") / LABEL
PLIST = Path("/Library/LaunchDaemons") / (LABEL + ".plist")
APP = "/Applications/Tailscale.app/Contents/MacOS/Tailscale"


class ModeError(Exception):
    pass


def mode_name(state):
    return "Awake" if state.get("local_only", False) else "Remote"


def check_mode(state, local_only):
    if state.get("local_only", False) != local_only:
        active = mode_name(state).lower()
        raise ModeError("A " + active + " session already owns the sleep settings. Run "
                        + active + " stop before switching modes.")


def run(args, timeout=20, check=True):
    environment = os.environ.copy()  # Preserve the macOS GUI/XPC session for Tailscale.
    environment["PATH"] = "/usr/bin:/bin:/usr/sbin:/sbin"
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=timeout,
                                cwd="/", env=environment)
    except (subprocess.TimeoutExpired, OSError) as error:
        raise ModeError(str(error)) from error
    if check and result.returncode:
        raise ModeError((result.stderr or result.stdout).strip() or str(args))
    return result


def on_ac():
    return "'AC Power'" in run(["/usr/bin/pmset", "-g", "batt"]).stdout


def sleep_disabled():
    for line in run(["/usr/bin/pmset", "-g"]).stdout.splitlines():
        fields = line.split()
        if fields and fields[0] == "SleepDisabled":
            return int(fields[1])
    raise ModeError("Cannot read SleepDisabled; no power setting was changed.")


def set_sleep(value):
    run(["/usr/bin/pmset", "-a", "disablesleep", str(value)])
    if sleep_disabled() != value:
        raise ModeError("macOS did not apply SleepDisabled=" + str(value))


def boot_id():
    return run(["/usr/sbin/sysctl", "-n", "kern.bootsessionuuid"]).stdout.strip()


def atomic_write(path, data, mode=0o644):
    fd, temporary = tempfile.mkstemp(dir=str(path.parent))
    try:
        with os.fdopen(fd, "wb") as stream:
            os.fchmod(stream.fileno(), mode)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def save(state):
    atomic_write(STATE, json.dumps(state, indent=2).encode() + b"\n")


def load():
    return json.loads(STATE.read_text()) if STATE.exists() else None


def result(ok, message):
    atomic_write(RESULT, json.dumps(dict(ok=ok, message=message, at=time.time())).encode())


def notify(state, message):
    try:
        script = ('display notification ' + json.dumps(message) + ' with title '
                  + json.dumps(mode_name(state) + " failed"))
        as_user(state, ["/usr/bin/osascript", "-e", script], timeout=5, check=False)
    except ModeError:
        pass


def failure(state, message):
    state["last_error"] = message
    save(state)
    result(False, message)
    print("ERROR: " + message, flush=True)
    notify(state, message)


def duration(text):
    if text.isdigit():
        seconds = int(text) * 3600  # Retain the original bare-hours syntax.
    else:
        parts = re.findall(r"(\d+)([smhd])", text.lower())
        if not parts or "".join(n + u for n, u in parts) != text.lower():
            raise ModeError("Invalid duration. Use, for example, 30m, 2h, or 1h30m.")
        seconds = sum(int(n) * {"s": 1, "m": 60, "h": 3600, "d": 86400}[u] for n, u in parts)
    if not 1 <= seconds <= 7 * 86400:
        raise ModeError("Duration must be between 1 second and 7 days.")
    return seconds


def sleep_count():
    output = run(["/usr/bin/pmset", "-g", "stats"]).stdout
    match = re.search(r"(?m)^\s*Sleep Count:\s*(\d+)", output)
    if not match:
        raise ModeError("Cannot read macOS sleep counters; sleep cannot be verified.")
    return int(match.group(1))


@contextlib.contextmanager
def locked():
    DIRECTORY.mkdir(mode=0o755, exist_ok=True)
    if DIRECTORY.is_symlink() or DIRECTORY.stat().st_uid != 0:
        raise ModeError("Remote-mode state directory must be owned by root.")
    with (DIRECTORY / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def as_user(state, args, timeout=20, check=True):
    command = ["/usr/bin/sudo", "-n", "-H", "-u", "#" + str(state["uid"]), "--"] + args
    if state["gui"]:
        command = ["/bin/launchctl", "asuser", str(state["uid"])] + command
    return run(command, timeout=timeout, check=check)


def vpn_state(state):
    result = as_user(state, [state["cli"], "status", "--json"])
    return json.loads(result.stdout)["BackendState"]


def select_cli():
    # Studio's standalone daemon must use its matching CLI, never the GUI shim.
    daemon = run(["/usr/bin/pgrep", "-x", "tailscaled"], check=False).returncode == 0
    if daemon:
        for candidate in ("/opt/homebrew/bin/tailscale", "/usr/local/bin/tailscale"):
            if Path(candidate).exists() and Path(candidate).resolve().name != "Tailscale":
                # /usr/local/bin/tailscale can be a shell shim pointing at the GUI.
                with open(candidate, "rb") as stream:
                    if stream.read(2) != b"#!":
                        return candidate, False
        raise ModeError("Standalone tailscaled found, but its matching CLI is missing.")
    if not Path(APP).exists():
        raise ModeError("Install and sign in to Tailscale before starting remote mode.")
    return APP, True


def app_running(uid):
    return run(["/usr/bin/pgrep", "-u", str(uid), "-fx", APP], check=False).returncode == 0


def install_watchdog():
    HELPER.parent.mkdir(mode=0o755, exist_ok=True)
    atomic_write(HELPER, Path(__file__).read_bytes(), 0o755)
    config = {
        "Label": LABEL,
        "ProgramArguments": ["/usr/bin/python3", "-I", str(HELPER), "_watch"],
        "RunAtLoad": True,
        "KeepAlive": {"SuccessfulExit": False},
        "ThrottleInterval": 5,
        "StandardOutPath": str(DIRECTORY / "watchdog.log"),
        "StandardErrorPath": str(DIRECTORY / "watchdog.log"),
    }
    atomic_write(PLIST, plistlib.dumps(config))
    run(["/bin/launchctl", "bootout", "system/" + LABEL], check=False)
    run(["/bin/launchctl", "bootstrap", "system", str(PLIST)])


def restore(state, remove=True):
    """Retry VPN cleanup if necessary, but always restore sleep on the first attempt."""
    error = None
    try:
        if state["connected_by_mode"]:
            as_user(state, [state["cli"], "down"])
            if vpn_state(state) != "Stopped":
                raise ModeError("Tailscale did not disconnect; cleanup will retry.")
            state["connected_by_mode"] = False
            save(state)
        if state["opened_by_mode"] and app_running(state["uid"]):
            # Quit only the GUI that this session opened, after disconnecting it.
            as_user(state, ["/usr/bin/osascript", "-e", 'tell application "Tailscale" to quit'])
            if app_running(state["uid"]):
                raise ModeError("Tailscale did not quit; cleanup will retry.")
        state["opened_by_mode"] = False
        save(state)
    except (ModeError, ValueError, KeyError) as failure:
        error = failure
    finally:
        set_sleep(state["sleep_before"])
    if error:
        raise ModeError(str(error))
    if remove:
        STATE.unlink()


def begin_sleep(state):
    # The recovery record survives sleep/reboot. Restore even a pre-existing
    # desktop SleepDisabled=1 after wake; leave hibernation/standby policy alone.
    state.update(phase="sleeping", sleep_count_before=sleep_count(), sleep_requested_at=time.time())
    save(state)
    set_sleep(0)
    result(True, "Timer expired; native system sleep requested.")
    run(["/usr/bin/pmset", "sleepnow"])


def sleep_failure(state, message):
    try:
        set_sleep(state["sleep_before"])
    except ModeError as error:
        failure(state, message + "; power restoration also failed: " + str(error))
        raise
    STATE.unlink()
    result(False, message)
    print("ERROR: " + message, flush=True)
    notify(state, message)


def complete_sleep(state):
    rebooted = state["boot"] != boot_id()
    if rebooted or sleep_count() > state["sleep_count_before"]:
        set_sleep(state["sleep_before"])
        STATE.unlink()
        message = ("Timed session ended; reboot interrupted sleep verification; previous settings restored."
                   if rebooted else "Timed session ended; native system sleep observed; previous settings restored.")
        result(True, message)
        return True
    if time.time() - state["sleep_requested_at"] >= 30:
        message = "Timer ended, but macOS did not enter sleep within 30 seconds. Check other apps/power assertions."
        # Leave no polling process or sleep override after a failed request.
        sleep_failure(state, message)
        return True
    return False


def end_reason(state, now, ac, boot, console_uid):
    if state.get("stop"):
        return "stopped by user"
    if state["boot"] != boot:
        return "reboot"
    if state["phase"] != "active":
        return "interrupted start"
    if now >= state["deadline"]:
        return "session expired"
    if not ac and not state.get("local_only", False):
        return "power disconnected"
    if state["gui"] and console_uid != state["uid"]:
        return "user logged out or switched"
    return None


def watch():
    while True:
        with locked():
            state = load()
            if state is None:
                return
            if state["phase"] == "sleeping":
                try:
                    finished = complete_sleep(state)
                except ModeError as error:
                    sleep_failure(state, "Sleep verification failed: " + str(error))
                    return
                if finished:
                    return
                time.sleep(1)
                continue
            reason = end_reason(state, time.time(), on_ac(), boot_id(),
                                os.stat("/dev/console").st_uid)
            if not state.get("stop"):
                reason = state.get("end_reason", reason)
            if reason:
                state["phase"] = "restoring"
                state["end_reason"] = reason
                save(state)
                print("Restoring " + mode_name(state).lower() + " mode: " + reason, flush=True)
                try:
                    timed = state.get("sleep_on_expiry", False) and reason == "session expired"
                    restore(state, remove=not timed)
                    if timed:
                        try:
                            begin_sleep(state)
                        except ModeError as error:
                            sleep_failure(state, "Native sleep request failed: " + str(error))
                            return
                        continue
                    result(True, mode_name(state) + " OFF: " + reason + ". Previous settings restored.")
                    print("Previous sleep/VPN state restored.", flush=True)
                    return
                except ModeError as error:
                    failure(state, "Cleanup failed; will retry: " + str(error))
                    time.sleep(15)
        time.sleep(2)


def root_start(uid, seconds, local_only=False):
    name = "Awake" if local_only else "Remote"
    if uid == 0:
        raise ModeError("Start as your normal account; the command will use sudo as needed.")
    pwd.getpwuid(uid)
    with locked():
        existing = load()
        if existing is not None:
            check_mode(existing, local_only)
            if existing["phase"] != "active" or existing["uid"] != uid or existing["boot"] != boot_id():
                raise ModeError("A cleanup or sleep request is pending. Run " + name.lower()
                                + " status, then " + name.lower() + " stop.")
            if not local_only and not on_ac():
                raise ModeError("Cannot renew: connect the power adapter first.")
            if not local_only and vpn_state(existing) != "Running":
                raise ModeError("Cannot renew: connect Tailscale first, or run remote stop.")
            try:
                install_watchdog()
                set_sleep(1)
                existing.update(deadline=time.time() + seconds, sleep_on_expiry=True)
                existing.pop("last_error", None)
                save(existing)
                result(True, name + " session renewed.")
            except (ModeError, OSError, ValueError, KeyError) as original:
                existing["phase"] = "restoring"
                save(existing)
                try:
                    restore(existing)
                except ModeError as cleanup:
                    failure(existing, "Renewal failed: " + str(original) + "; cleanup also failed: " + str(cleanup))
                    raise ModeError(existing["last_error"]) from original
                result(False, "Renewal failed; previous settings restored: " + str(original))
                raise
            print(name + " ON until " + time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(existing["deadline"]))
                  + "; then native system sleep. Stop early: " + name.lower() + " stop")
            return
        if not local_only and not on_ac():
            raise ModeError("Connect the power adapter before starting " + name.lower() + " mode.")
        cli, gui = (None, True) if local_only else select_cli()
        if gui and os.stat("/dev/console").st_uid != uid:
            raise ModeError("Log in to this Mac's desktop before starting " + name.lower() + " mode.")
        state = {"uid": uid, "gui": gui, "cli": cli, "boot": boot_id(),
                 "local_only": local_only,
                 "sleep_before": sleep_disabled(), "deadline": time.time() + seconds, "sleep_on_expiry": True,
                 "phase": "starting", "connected_by_mode": False, "opened_by_mode": False}
        if not local_only:
            before = vpn_state(state)
            if before not in ("Running", "Stopped"):
                raise ModeError("Tailscale is " + before + "; sign in/connect manually first.")
            state["connected_by_mode"] = before == "Stopped"
            state["opened_by_mode"] = gui and not app_running(uid)
        save(state)
        try:
            # Recovery must exist before any VPN or persistent power change.
            install_watchdog()
            if state["opened_by_mode"]:
                as_user(state, ["/usr/bin/open", "-g", "-a", "Tailscale"])
            if state["connected_by_mode"]:
                # No CLI flags: retain existing route/DNS/exit-node preferences.
                as_user(state, [cli, "up"], timeout=30)
            if not local_only and vpn_state(state) != "Running":
                raise ModeError("Tailscale is not connected.")
            if not local_only and not on_ac():
                raise ModeError("Power was disconnected during startup.")
            set_sleep(1)
            state["phase"] = "active"
            state["deadline"] = time.time() + seconds
            save(state)
            result(True, name + " session started.")
        except (ModeError, OSError, ValueError, KeyError) as original:
            state["phase"] = "restoring"
            save(state)
            try:
                restore(state)
            except ModeError as cleanup:
                failure(state, "Start failed: " + str(original) + "; cleanup also failed: " + str(cleanup))
                raise ModeError(state["last_error"]) from original
            result(False, "Start failed; previous settings restored: " + str(original))
            raise
    print(name + " ON until " + time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(state["deadline"]))
          + "; then native system sleep. Stop early: " + name.lower() + " stop")


def root_stop(local_only=False):
    name = "Awake" if local_only else "Remote"
    with locked():
        state = load()
        if state is None:
            print(name + " is already OFF.")
            return
        check_mode(state, local_only)
        print("Stopping awake." if local_only else
              "Stopping remote; SSH may disconnect if this session started Tailscale.", flush=True)
        state["stop"] = True
        state["phase"] = "restoring"
        save(state)
        # Work even if the service was unloaded. The watchdog is an independent
        # fallback if SSH drops while disconnecting this Mac from Tailscale.
        try:
            restore(state)
        except ModeError as error:
            failure(state, "Stop failed; cleanup is pending: " + str(error))
            raise
        message = name + " OFF. Previous " + ("sleep" if local_only else "sleep/VPN") + " state restored."
        result(True, message)
    print(message)


def status(local_only=False):
    state = load()
    errors = []
    if state is None:
        name = "Awake" if local_only else "Remote"
        print(name + " OFF. No active awake/remote session or polling watchdog is needed.")
        if RESULT.exists():
            previous = json.loads(RESULT.read_text())
            print("Last result: " + previous["message"])
            if not previous["ok"]:
                errors.append(previous["message"])
    else:
        name = mode_name(state)
        local_only = state.get("local_only", False)
        print(name + ": " + state["phase"] + (" (stop requested)" if state.get("stop") else ""))
        print("Expires: " + time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(state["deadline"]))
              + ("; then native system sleep" if state.get("sleep_on_expiry") else "; restore previous settings"))
        if local_only:
            print("Local work only; Tailscale and SSH are not managed or required.")
        else:
            print("Tailscale will be " + ("disconnected" if state["connected_by_mode"] else "preserved") + " on stop.")
        service = run(["/bin/launchctl", "print", "system/" + LABEL], check=False)
        if service.returncode or not re.search(r"(?m)^\s*pid = \d+", service.stdout):
            errors.append("Recovery watchdog is not running. Run " + name.lower() + " stop to restore settings.")
        if state.get("last_error"):
            errors.append(state["last_error"])
        if state["phase"] == "active":
            if time.time() >= state["deadline"]:
                errors.append("Session deadline has passed; cleanup has not completed.")
            if not local_only and not on_ac():
                errors.append("Power disconnected; cleanup has not completed.")
            if sleep_disabled() != 1:
                errors.append("Sleep override is missing; lid-closed access is not protected.")
            if not local_only:
                try:
                    vpn = (vpn_state(state) if os.getuid() == 0 else
                           json.loads(run([state["cli"], "status", "--json"]).stdout)["BackendState"])
                    if vpn != "Running":
                        errors.append("Tailscale is " + vpn + ".")
                except (ModeError, ValueError, KeyError) as error:
                    errors.append("Cannot check Tailscale: " + str(error))
    print("Power: " + ("AC" if on_ac() else "battery"))
    print("SleepDisabled: " + str(sleep_disabled()))
    if not local_only:
        try:
            with socket.create_connection(("127.0.0.1", 22), timeout=2):
                print("SSH: listening locally (peer access still needs a network test).")
        except OSError:
            print("SSH: not listening on localhost:22; enable Remote Login for SSH access.")
            if state and state["phase"] == "active":
                errors.append("SSH is not listening on localhost:22.")
    for error in errors:
        print("ERROR: " + error, file=sys.stderr)
    return 1 if errors else 0


def main():
    if sys.argv[1:2] in (["_watch"], ["_root"]):
        if os.getuid() != 0:
            raise ModeError("Internal recovery operations require root.")
        internal = sys.argv[1:]
        local_only = internal[-1:] == ["local"]
        if local_only:
            internal = internal[:-1]
        if internal == ["_watch"]:
            if local_only:
                raise ModeError("Invalid internal operation")
            watch()
        elif internal == ["_root", "stop"]:
            root_stop(local_only=local_only)
        elif len(internal) == 4 and internal[:2] == ["_root", "start"]:
            seconds = int(internal[3])
            if not 1 <= seconds <= 7 * 86400:
                raise ModeError("Duration must be between 1 second and 7 days.")
            root_start(int(internal[2]), seconds, local_only=local_only)
        else:
            raise ModeError("Invalid internal operation")
        return
    local_only = Path(sys.argv[0]).name == "awake"
    name = "awake" if local_only else "remote"
    default_seconds = 12600 if local_only else 12 * 3600
    default_duration = "3h30m" if local_only else "12h"
    parser = argparse.ArgumentParser(
        description=("Keep this Mac awake on battery or AC for local work, without managing Tailscale or SSH."
                     if local_only else "Temporary AC-only, lid-closed remote access over Tailscale."),
        usage=name + " {start [duration],stop,status}",
        epilog="Examples: " + name + " start; " + name + " start 30m; " + name + " start 2h. "
               "Default: " + default_duration + "; range: 1s–7d. Starting again resets the timer. Expiry restores settings "
               "and requests native system sleep. Standby/hibernation settings stay unchanged. "
               "Stop restores settings without forcing sleep. Nothing auto-starts on AC. "
               "Only one awake/remote session can run at a time. "
               "Errors return a nonzero status; automatic failures appear in " + name + " status.")
    parser.add_argument("action", choices=("start", "stop", "status"))
    parser.add_argument("arguments", nargs="*")
    args = parser.parse_args()
    if args.action == "status" and not args.arguments:
        return status(local_only=local_only)
    elif args.action in ("start", "stop"):
        command = ["/usr/bin/sudo", "/usr/bin/python3", "-I", str(Path(__file__).resolve()), "_root", args.action]
        if args.action == "start":
            if len(args.arguments) > 1:
                parser.error("Usage: " + name + " start [duration], e.g. " + name + " start 30m")
            seconds = duration(args.arguments[0]) if args.arguments else default_seconds
            if not local_only and not on_ac():
                raise ModeError("Connect the power adapter before starting " + name + " mode.")
            command += [str(int(os.environ.get("SUDO_UID", os.getuid()))), str(seconds)]
        elif args.arguments:
            parser.error("Usage: " + name + " stop")
        if local_only:
            command.append("local")
        os.execv(command[0], command)
    else:
        parser.error("Unexpected arguments")


if __name__ == "__main__":
    try:
        sys.exit(main() or 0)
    except (ModeError, OSError, ValueError, KeyError) as error:
        print(Path(sys.argv[0]).name + ": ERROR: " + str(error), file=sys.stderr)
        sys.exit(1)
