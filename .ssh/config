# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# Personal Macs. Route order: NAME (Tailscale MagicDNS), NAME-ip (Tailscale IP,
# no DNS needed), NAME-lan (Bonjour, same network only). `mac-reach NAME`
# prints the first route that answers. All routes share the canonical host key.
Host studio mac-studio studio-ts studio.tailed8082.ts.net
    HostName studio.tailed8082.ts.net
    HostKeyAlias studio.tailed8082.ts.net

Host studio-ip 100.95.1.50
    HostName 100.95.1.50
    HostKeyAlias studio.tailed8082.ts.net

Host studio-lan
    HostName studio.local
    HostKeyAlias studio.tailed8082.ts.net

Host air mac-air air-ts air.tailed8082.ts.net
    HostName air.tailed8082.ts.net
    HostKeyAlias air.tailed8082.ts.net

Host air-ip 100.82.17.2
    HostName 100.82.17.2
    HostKeyAlias air.tailed8082.ts.net

Host air-lan
    HostName air.local
    HostKeyAlias air.tailed8082.ts.net

Host pro mac-pro pro-ts pro.tailed8082.ts.net
    HostName pro.tailed8082.ts.net
    HostKeyAlias pro.tailed8082.ts.net

Host pro-ip 100.122.185.114
    HostName 100.122.185.114
    HostKeyAlias pro.tailed8082.ts.net

Host pro-lan
    HostName pro.local
    HostKeyAlias pro.tailed8082.ts.net

Host studio mac-studio studio-ts studio-ip studio-lan studio.tailed8082.ts.net 100.95.1.50 air mac-air air-ip air-lan air-ts air.tailed8082.ts.net 100.82.17.2 pro mac-pro pro-ip pro-lan pro-ts pro.tailed8082.ts.net 100.122.185.114
    User faustozamparelli
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    StrictHostKeyChecking yes
    ConnectTimeout 8
    ServerAliveInterval 15
    ServerAliveCountMax 3
